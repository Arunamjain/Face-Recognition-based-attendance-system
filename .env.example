# Firebase Configuration
# Path to the Firebase service account private key JSON file
# Download this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# (Optional) Explicit Firebase Project ID if not read from credentials file
FIREBASE_PROJECT_ID=

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ATTENDANCE_SESSION=DEFAULT_SESSION

# Recognition threshold to mark attendance
RECOGNITION_THRESHOLD=0.55
